    {
      "parameters": {
        "jsCode": "const raw=$json.text??$json.output??$json.response??'';\nlet invoice;\ntry{invoice=JSON.parse(String(raw).replace(/```json|```/g,'').trim())}catch(e){return [{json:{success:false,status:'ERROR',message:'AI returned invalid JSON',raw_ai_output:raw}}]}\nconst n=v=>Number(v??0); const subtotal=n(invoice.subtotal),cgst=n(invoice.cgst),sgst=n(invoice.sgst),igst=n(invoice.igst),total=n(invoice.total); const expected=subtotal+cgst+sgst+igst; const difference=Math.round((expected-total)*100)/100; const valid=Math.abs(difference)<=1;\nreturn [{json:{success:true,status:valid?'VALID':'REVIEW',message:valid?'Invoice processed successfully':'Invoice needs manual review',validation:{expected_total:expected,invoice_total:total,difference},invoice}}];"
      },
